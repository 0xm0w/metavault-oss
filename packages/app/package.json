{
  "name": "openvault-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenVault desktop app — Electron shell over vaultd. Holds no secrets.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.preload.json && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pack:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac",
    "pack:win:ai": "electron-builder --win -c.extraResources[0].from=models -c.extraResources[0].to=models -c.artifactName=OpenVault--with-ai--."
  },
  "build": {
    "appId": "dev.openvault.app",
    "productName": "MetaVault OSS",
    "artifactName": "OpenVault-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "bin/**/*",
      "package.json",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MetaVault OSS",
      "include": "scripts/installer.nsh",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "0xm0w",
      "repo": "openvault"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "MetaVault OSS",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "electronVersion": "45.2.1"
  },
  "author": "OpenVault contributors"
}

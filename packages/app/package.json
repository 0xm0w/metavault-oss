{
  "name": "metavault-app",
  "version": "0.1.4-alpha",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xm0w/metavault-oss.git"
  },
  "bugs": {
    "url": "https://github.com/0xm0w/metavault-oss/issues"
  },
  "homepage": "https://github.com/0xm0w/metavault-oss#readme",
  "private": true,
  "type": "module",
  "description": "MetaVault OSS desktop app — Electron shell over vaultd. Holds no secrets.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.preload.json && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pack:win": "npm run build && npm run bundle && electron-builder --win --publish never",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:win:store": "electron-builder --win appx --publish never",
    "bundle": "node scripts/bundle.mjs"
  },
  "build": {
    "appId": "dev.metavault.app",
    "productName": "MetaVault OSS",
    "artifactName": "MetaVault-OSS-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/main.bundle.cjs"
    },
    "files": [
      "dist/**/*",
      "!dist/bin/**",
      "!**/*.db*",
      "!**/*.key*",
      "!**/*.token",
      "!**/*.log",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "bundle/vaultd",
        "to": "vaultd"
      },
      {
        "from": "scripts/cleanup-profile.ps1",
        "to": "cleanup-profile.ps1"
      }
    ],
    "extraFiles": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "appx": {
      "identityName": "MetaVaultOSS",
      "applicationId": "MetaVaultOSS",
      "publisherDisplayName": "MetaVault OSS contributors",
      "displayName": "MetaVault OSS"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MetaVault OSS",
      "include": "scripts/installer.nsh",
      "runAfterFinish": true,
      "license": "TERMS.txt",
      "uninstallDisplayName": "MetaVault OSS ${version}",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "0xm0w",
      "repo": "metavault-oss"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "MetaVault OSS",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "electronVersion": "45.2.1"
  },
  "author": "MetaVault OSS contributors"
}

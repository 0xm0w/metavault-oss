{
  "name": "openvault-app",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "OpenVault desktop app â€” Electron shell over vaultd. Holds no secrets.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.preload.json && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pack:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.openvault.app",
    "productName": "OpenVault",
    "artifactName": "OpenVault-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "electronVersion": "45.2.1"
  },
  "author": "OpenVault contributors"
}

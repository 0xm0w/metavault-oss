<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.openvault.vaultd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/usr/local/share/openvault/packages/daemon/dist/server.js</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/openvault-vaultd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/openvault-vaultd.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>7077</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>
</dict>
</plist>
